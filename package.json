    "lint": "eslint server web tests scripts --ignore-pattern vendor",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "fastify": "^5.6.0",
