  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 3218",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
